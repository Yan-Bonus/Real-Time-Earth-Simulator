{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "city-record.schema.json",
  "title": "City reference record",
  "type": "object",
  "required": [
    "id",
    "name_zh",
    "name_en",
    "country",
    "longitude",
    "latitude",
    "coordinate_reference_system",
    "coordinate_role",
    "coordinate_source",
    "selection",
    "description_zh",
    "city_card",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name_zh": {
      "type": "string"
    },
    "name_en": {
      "type": "string"
    },
    "aliases": {
      "type": "array"
    },
    "country": {
      "type": "object",
      "required": [
        "iso3",
        "name_zh",
        "name_en"
      ],
      "properties": {
        "iso3": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "name_zh": {
          "type": "string",
          "minLength": 1
        },
        "name_en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scope": {
      "enum": [
        "china",
        "foreign"
      ]
    },
    "admin_level": {
      "type": [
        "string",
        "null"
      ]
    },
    "wikidata_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "longitude": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "latitude": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "coordinate_reference_system": {
      "const": "EPSG:4326"
    },
    "coordinate_role": {
      "type": "string"
    },
    "coordinate_source": {
      "type": "string"
    },
    "selection": {
      "type": "object"
    },
    "description_zh": {
      "type": "string",
      "minLength": 1
    },
    "description_attribution": {
      "type": "object"
    },
    "city_card": {
      "type": "object",
      "required": [
        "title_zh",
        "caption",
        "image",
        "selection_method"
      ],
      "properties": {
        "image": {
          "type": "object",
          "required": [
            "url",
            "source_page",
            "license_status",
            "is_ai_generated"
          ],
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "source_page": {
              "type": "string",
              "format": "uri"
            },
            "license_status": {
              "enum": [
                "stated",
                "not_stated"
              ]
            },
            "is_ai_generated": {
              "const": false
            }
          }
        }
      }
    },
    "sources": {
      "type": "array"
    },
    "quality_notes": {
      "type": "array"
    }
  }
}